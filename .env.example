# Copy to .env and fill in. NEVER put real production secrets here — this is a
# deception lab and everything in it is synthetic by design.

# Optional: enables AI-generated decoy content. Without it, the generator uses a
# deterministic offline fallback so the lab still works end-to-end.
ANTHROPIC_API_KEY=

# Where producers send events. Set in containers; leave unset for local dry-runs
# (personas/attacker sim then write straight to the SQLite store).
# HUB_URL=http://hub:8000

# Local SQLite event store path (used when HUB_URL is unset).
EVENTS_DB=data/events.db

# Demo time compression: 1.0 = real time; higher = faster simulated day.
# e.g. 288 makes a 24h day pass in 5 minutes.
TIME_SCALE=288
